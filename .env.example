# Fiasco runs with no configuration at all: without these values the game uses a local
# ledger and says so in the header. Copy this file to .env.local to turn features on.

# NEAR testnet RPC. Also used (no key needed) to seed each round from the latest block.
NEAR_TESTNET_RPC_URL=https://test.rpc.fastnear.com

# On-chain chip ledger. The relayer account signs every ledger write; the contract must
# have been initialised with this account as its verifier (see `npm run contract:deploy`).
NEAR_RELAYER_ACCOUNT_ID=
NEAR_RELAYER_PRIVATE_KEY=
NEAR_CONTRACT_ID=

# Optional: let NEAR AI Cloud drive the couriers, with TEE attestation.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V3.1

# Optional: only for voicing the trailer with ElevenLabs (npm run film:voice:eleven).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
